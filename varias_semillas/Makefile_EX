# Hvb makefile

hvb=$(HOME)/lib/hvb/Hvb_Current/

# FLAGS=-pedantic -Wall -g -I$(hvb) -O3 
# LIBS=-lm -L/usr/X11R6/lib -lrt  -lX11 -lImlib2 

FLAGS=-pedantic -Wall -g -I$(hvb) -O3 -DDEBUG
LIBS=-llapack -lblas -lm -L/usr/X11R6/lib -lX11 -lImlib2 


HVBS= $(hvb)Matrix.o $(hvb)Common.o $(hvb)Text.o $(hvb)EX.o 

# OBJECTS = rays_160202.o graphics.o histogram.o

objects: $(HVBS) $(OBJECTS)

%.o: %.cc
	g++ -c $< $(FLAGS) -o $@

x%: x%.o objects
	g++ $(FLAGS) -o $@ $< $(OBJECTS) $(HVBS) $(LIBS)

clean:
	ls x* | grep -v "\." | xargs rm -f
	rm *.o 

mrproper: 	
	rm *.o $(hvb)/*.o

